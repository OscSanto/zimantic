# Zimantic search server (user unit).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/zimantic.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now zimantic.service
#
# Install the CLI from the checkout first:
#   cd ~/.local/share/zimantic
#   uv sync --locked --no-dev --no-editable
#   install -d ~/.local/bin
#   ln -sfn "$PWD/.venv/bin/zimantic" ~/.local/bin/zimantic
# The default data directory is ~/.local/share/zimantic.
# Use `uv tool install zimantic` after a PyPI release.

[Unit]
Description=Zimantic search server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/zimantic
ExecStart=%h/.local/bin/zimantic serve
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# Hardening: the server only needs to read zims/model and write indexes/ plus
# its PID file, all under the XDG data directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.local/share/zimantic
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

# Tune to the device, leaving headroom for the OS. See configs/ for profiles.
#MemoryMax=450M
#CPUQuota=90%

[Install]
WantedBy=default.target
