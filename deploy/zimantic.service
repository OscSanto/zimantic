# Zimantic search server (user unit).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/zimantic.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now zimantic.service
#
# Install the CLI from the checkout first:
#   cd ~/.local/share/zimantic
#   uv sync --locked --no-dev --no-editable
#   install -d ~/.local/bin
#   ln -sfn "$PWD/.venv/bin/zimantic" ~/.local/bin/zimantic
# The default data directory is ~/.local/share/zimantic.

[Unit]
Description=Zimantic search server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/zimantic
ExecStart=%h/.local/bin/zimantic serve
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# Hardening: the server only needs to read zims/model and write indexes/ plus
# its PID file, all under the XDG data directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.local/share/zimantic
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

# Tune to the device, leaving headroom for the OS (and kiwix-serve). MemoryMax
# caps the service inside its own cgroup so a search spike OOMs Zimantic, not the
# whole device; OOMScoreAdjust>0 makes Zimantic the preferred victim if the
# device still runs out of RAM (protecting sshd/kiwix-serve).
# Raspberry Pi Zero 2 W (512 MB):
#   MemoryMax=450M
#   OOMScoreAdjust=200
#
# Raspberry Pi 5 (4-8 GB):
#   MemoryMax=1G
#   OOMScoreAdjust=0

[Install]
WantedBy=default.target
