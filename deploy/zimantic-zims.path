# Watch zim_dir and trigger a fast index + reload whenever a ZIM is added.
# The nightly full build (deploy/zimantic-index-full.timer) is constrained to
# its configured time window.
#
# Install:
#   cp deploy/zimantic-zims.path deploy/zimantic-index.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now zimantic-zims.path
#   cp deploy/zimantic-index-full.service deploy/zimantic-index-full.timer ~/.config/systemd/user/
#   systemctl --user enable --now zimantic-index-full.timer
#
# Watch zims/, not indexes/: build writes into indexes/, so a path unit there
# would fire on its own output.

[Unit]
Description=Index new ZIMs and rescan Zimantic

[Path]
Unit=zimantic-index.service
PathChanged=%h/.local/share/zimantic/zims

[Install]
WantedBy=default.target
