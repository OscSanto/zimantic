# One-shot: index any new ZIMs (fast) and ask the server to rescan.
#
# Install alongside deploy/zimantic-indexing-fast.path. See that file for instructions.
# The nightly full build lives in deploy/zimantic-indexing.service/.timer.
#
# The path watch runs this fast build whenever a ZIM is added, without a time
# constraint. The full build remains constrained to its nightly window.
# Replace `build --fast` with `build` to add meaning vectors too (much slower on
# low-power hardware; building on a faster machine and copying indexes/ is
# usually better).

[Unit]
Description=Index new ZIMs (fast) and tell Zimantic to rescan

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/zimantic
# Serialize against the nightly full build: `build` takes the index lock itself,
# and --no-wait-lock exits 75 instead of queueing when the other build holds it.
# A skipped trigger is not an error, and reload waits for that other build.
ExecStart=/bin/sh -c 'build_status=0; "%h/.local/bin/zimantic" build --no-wait-lock --fast --wait-stable || build_status=$?; if [ "$build_status" -eq 75 ]; then echo "zimantic: another build is running, fast build skipped" >&2; exit 0; fi; reload_status=0; "%h/.local/bin/zimantic" reload || reload_status=$?; if [ "$build_status" -ne 0 ]; then exit "$build_status"; fi; exit "$reload_status"'
NoNewPrivileges=yes
PrivateTmp=yes
