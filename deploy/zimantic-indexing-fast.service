# One-shot: index any new ZIMs (fast) and ask the server to rescan.
#
# Install alongside deploy/zimantic-indexing-fast.path. See that file for instructions.
# The nightly full build lives in deploy/zimantic-indexing.service/.timer.
#
# The path watch runs this fast build whenever a ZIM is added, without a time
# constraint. The full build remains constrained to its nightly window.
# Replace `build --fast` with `build` to add meaning vectors too (much slower on
# low-power hardware; building on a faster machine and copying indexes/ is
# usually better).

[Unit]
Description=Index new ZIMs (fast) and tell Zimantic to rescan

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/zimantic
# Serialize against the nightly full build: if it already holds the lock, skip
# instead of touching the same index files concurrently. Keep the build's exit
# status visible to systemd; a failed build must not look like a lock skip.
ExecStart=/bin/sh -c 'if ! exec 9>"%t/zimantic-build.lock"; then echo "zimantic: unable to open build lock" >&2; exit 1; fi; if ! /usr/bin/flock -n 9; then echo "zimantic: another build is running, fast build skipped" >&2; exit 0; fi; exec "%h/.local/bin/zimantic" build --fast'
ExecStart=%h/.local/bin/zimantic reload
NoNewPrivileges=yes
PrivateTmp=yes
